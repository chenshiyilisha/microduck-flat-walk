  "training_parity": {
    "same": [
      "HD1910 plant 'p3' = hd1910_official_m6_kp5 (json=official_m6_stslaw.json, kp_fw=5, model=m6, target_names_expr excludes passive_*) \u2014 patched via rehearse_hd1910.py",
