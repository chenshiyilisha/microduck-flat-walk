# Local to microduck-software (also covered by workspace root .gitignore)

.venv/
.venv-*/
.upstream/
repo/
bin/

logs/
# out/ is build output, EXCEPT the bench measurements -- those are evidence
# (a sine CSV is the only record of a hardware run) and must stay in VCS.
out/*
!out/sine/
!out/kpsweep_hdg/
!out/hdg2000/
!out/hdg2499/
!out/rehearse_*.json
!out/plantP_*.json
!out/plantFreq_*.json
!out/heading_meta_*.json
# Patterns, not a blanket !out/plant*.json: that also un-ignores last week's
# run metadata, which is build noise rather than evidence.
wandb/
*.pt
*.onnx
MUJOCO_LOG.TXT

__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

.env
.env.*
!.env.example
