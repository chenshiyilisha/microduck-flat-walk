// head_shell_vent.scad
// ============================================================================
// MicroDuck 头部外壳（头盖）减重/美观孔 —— 参数化生成源（v2 设计）
//
// 衍生自：AiBoBoMaker/MicroDuck-BoBoRedesign
//         01-3DPrint/02-HD-1910-C001/stl模型/躯体部分/头盖.stl
// 许可：原模型 CC BY-SA-NC（署名-相同方式共享-非商业）；
//       本改动为个人非商业复刻的衍生件，沿用 same license，须保留署名。
//
// 用法（OpenSCAD，本地免费软件）：
//   1. 把 BoBo 仓库的「头盖.stl」复制到与本文件同一目录（或改下面 HEAD_STL 路径）。
//   2. OpenSCAD 打开本文件 → F6 渲染 → 导出 STL 即可打印。
//   3. 改下面 holes / r / H 即可重排或改孔径。
//
// ----------------------------------------------------------------------------
// 设计调研结论（2026-11-13 迭代 v2）：
//   - 官方 top_head_shell 与 BoBo 头盖是【同一几何】（仅 90° 旋转+平移，bbox 完全一致），
//     两者都是光滑 dome，**没有任何现成通风/减重通孔**；仅后端边缘有 5 个长条状
//     表面凹陷/装配缺口（watertight 仍 True，说明是表面特征而非通孔）。
//   - 因此【没有现成带孔头部可直接复用】，必须自行设计。
//   - 头盖是薄壳（内外双层壁）：竖直圆柱在斜面上打孔会变成椭圆、且从外侧透出内壁边
//     显得"脏"；所以孔必须落在【法线接近竖直】的平坦区，竖直打孔才是正圆。
//   - 经顶点法线+局部平整度分析，真正的水平平坦区是【头顶沿头长方向的纵向脊线带】
//     （法线 Z>0.9 区域质心 ≈ (X0, Y-25.7, Z41.5)，跨度 X±26、Y[-65,37]），
//     远离后端 5 槽与四周边缘 → 在此开孔最优。
//   - v1 的 25 个小六边形孔之所以"难看"：数量多+位于弯曲/边缘区→破碎琐碎；
//     v1.5 的 3 孔误放在后端脊线末端（Y≈-57）靠近边缘→仍破碎。
//   - v2：在【中央脊线带】放 3 个三角对称圆孔（1 居中上 + 2 并列下），
//     d=9mm、竖直穿透薄壳，互不融合、watertight 保持，俯视规整、立体观感像"脸"图案。
//
// 坐标说明：沿用 BoBo STL 原始坐标系（Z 为竖直轴，Z∈[0,46.3]；
//   头顶脊线在 Y≈-25、Z≈40；后端 5 槽在 Y≈-65 边缘）。孔心 Z 取 40、H=14
//   以跨越薄壳上下壁形成干净通孔。
// ============================================================================

HEAD_STL = "头盖.stl";          // 同目录的 BoBo 头盖 STL

// ---- v2 孔位（头顶中央脊线带，三角对称）----
// 单位 mm；XY 为 BoBo STL 平面坐标，Z=40 为脊线表面高度
holes = [ [0.0, -24.0],
          [-11.0, -14.0],
          [11.0, -14.0] ];
r   = 4.5;                    // 孔径半径 → 直径 9mm
H   = 14.0;                   // 圆柱高度（>薄壳厚度，确保穿透）

difference() {
  import(HEAD_STL);

  for (h = holes) {
    translate([h[0], h[1], 40])
      cylinder(h = H, r = r, $fn = 32, center = true);
  }
}
