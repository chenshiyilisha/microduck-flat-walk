+/*
+ * Half-duplex direction (DE/RE) control for boards with a "485_ctrl_gpio".
+ *
+ * This deliberately does not go through em485. On this SoC enabling em485
+ * wedges TX after the first frame: __stop_tx() returns early at its !THRE
+ * check, so the stop_tx hrtimer is never armed, THRI stays set, and the next
+ * __start_tx() sees THRI already set and does nothing. Measured on this SoC
+ * (ttyS0/3/4/5, with and without a DE pin), so it is not caused by direction
+ * control — but it does mean direction control has to live here.
+ *
+ * Polarity comes from the DT gpio flags cell rather than port.rs485.flags,
+ * because uart_sanitize_serial_rs485() memsets that struct whenever
+ * SER_RS485_ENABLED is absent, which is exactly the case here.
+ */
+static void serial8250_de_assert(struct uart_8250_port *up)
+{
+	if (up->de_gpio < 0)
+		return;
+
+	gpio_set_value(up->de_gpio, up->de_active_low ? 0 : 1);
+}
+
+static void serial8250_de_release(struct uart_8250_port *up)
+{
+	unsigned int budget_us;
+
+	if (up->de_gpio < 0)
+		return;
+
+	/*
+	 * The bytes just handed to the FIFO are still shifting out; releasing
+	 * the transceiver now would truncate the frame. Busy-wait for TEMT.
+	 *
+	 * This runs from the TX interrupt with port->lock held, so the wait is
+	 * bounded by how long a full batch physically takes at the current baud
+	 * rate: frame_time is ns per character, and 48 characters at 1Mbps is
+	 * 480us (a 10-byte servo frame is ~100us). Slow baud rates with a DE pin
+	 * wait proportionally longer.
+	 */
+	budget_us = DIV_ROUND_UP(up->port.frame_time, NSEC_PER_USEC) *
+		    (up->tx_loadsz + 2);
+	/*
+	 * Converting per character first keeps this in 32-bit range even at
+	 * absurdly slow baud rates. Zero means frame_time has not been set up
+	 * yet (no set_termios so far), so fall back to the ceiling.
+	 */
+	if (!budget_us || budget_us > 50000)
+		budget_us = 50000;
+
+	while (budget_us--) {
+		if (serial_lsr_in(up) & UART_LSR_TEMT)
+			break;
+		udelay(1);
+	}
+
+	gpio_set_value(up->de_gpio, up->de_active_low ? 1 : 0);
+}
