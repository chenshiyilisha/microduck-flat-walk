<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Material 3 固定深色 · 官方清单落地（2026-11-20）。

      一手：m3.material.io Color roles / Dark theme / Usability；
      primary 仅服务主动作；surface* 表达层级；鸭橙 trim 作 primary（品牌，非装饰堆色）。
      详见 docs/active/microduck-安卓App-M3官方清单对照落地-2026-11-20.md
    -->
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/md_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="colorPrimary">@color/md_accent</item>
        <item name="colorOnPrimary">@color/md_bg</item>
        <item name="colorPrimaryContainer">@color/md_accent_container</item>
        <item name="colorOnPrimaryContainer">@color/md_text</item>
        <item name="colorSecondary">@color/md_warn</item>
        <item name="colorTertiary">@color/md_ok</item>
        <item name="colorError">@color/md_bad</item>
        <item name="colorOnError">@color/md_bg</item>

        <item name="colorSurface">@color/md_surface</item>
        <item name="colorSurfaceVariant">@color/md_card_alt</item>
        <item name="colorSurfaceContainerLowest">@color/md_bg</item>
        <item name="colorSurfaceContainerLow">@color/md_card</item>
        <item name="colorSurfaceContainer">@color/md_card_alt</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_highest</item>
        <item name="colorOnSurface">@color/md_text</item>
        <item name="colorOnSurfaceVariant">@color/md_text_dim</item>

        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
    </style>

    <!-- 暖石墨阶梯（非冷蓝黑） -->
    <color name="md_bg">#141311</color>
    <color name="md_card">#1E1C19</color>
    <color name="md_card_alt">#282521</color>

    <color name="md_text">#F2F0EA</color>
    <color name="md_text_dim">#A39E93</color>

    <!-- 鸭橙 trim 作唯一强调；状态色降饱和 -->
    <color name="md_accent">#C9904A</color>
    <color name="md_warn">#C7A052</color>
    <color name="md_ok">#7A9E78</color>
    <color name="md_bad">#C56E66</color>

    <color name="md_surface">#1E1C19</color>
    <color name="md_surface_high">#282521</color>
    <color name="md_surface_highest">#322F29</color>
    <color name="md_outline">#3A3731</color>
    <color name="md_outline_variant">#2C2A25</color>
    <color name="md_accent_container">#2A2218</color>
</resources>
